# ============================================
# BubLuv - Contoh Environment Variables
# SALIN file ini menjadi .env untuk development lokal,
# dan masukkan nilai yang sama di Vercel Dashboard
# (Project Settings -> Environment Variables).
# JANGAN pernah commit file .env ke GitHub!
# ============================================

# --- Database Aiven MySQL ---
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- SSL Aiven ---
# Set 'true' jika host Aiven memerlukan SSL/TLS (umumnya ya, mis. mysql-xxx.aivencloud.com)
DB_SSL=true
# Opsional: sertakan CA certificate Aiven (satu baris atau escape \n)
# DB_SSL_CA=
# Set 'false' hanya untuk koneksi non-SSL yang aman (mis. database lokal)
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- Auth ---
# Secret untuk menandatangani JWT. WAJIB diganti dengan string acak panjang!
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Opsional ---
# Password admin yang di-hash saat menjalankan script seed (default: password)
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=

# CORS origin (default: *)
# CORS_ORIGIN=https://bubluv.vercel.app
